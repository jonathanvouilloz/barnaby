{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Barnaby",
  "version": "0.2.0",
  "identifier": "app.barnaby.desktop",
  "build": {
    "beforeDevCommand": "bun run --cwd ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run --cwd ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Barnaby",
        "width": 1100,
        "height": 720,
        "minWidth": 760,
        "minHeight": 520,
        "decorations": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; media-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/meetings/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "nsis", "msi"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Productivity",
    "linux": { "deb": { "depends": ["pulseaudio-utils"] } }
  }
}
